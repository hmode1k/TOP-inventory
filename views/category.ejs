<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= locals.category[0].category %></h1>
    <form action="/category/<%= locals.category[0].id %>/edit" method="POST">
        <label for="categoryName">Category Name:</label>
        <input type="text" name="categoryName" value="<%= locals.category[0].category %>">
        <button type="submit">Edit</button>
    </form>

    <a href="/category/<%= locals.category[0].id %>/delete">DELETE CATEGORY</a>
</body>
</html>