<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gaminv</title>
</head>
<body>
    <h1>Game inventory</h1>
    <div>
        <h2>Games</h2>
        <form action="/games/create" method="get"><button type="submit" >Add A Game</button></form>
        
        
        <a href="/games">See All Games</a>
        <ul>
            <% if (locals.games) { %>
                <% games.forEach(game => { %>
                    <li><a href="/games/<%= game.id %>" ><%= game.game_name %></a></li>
                <% }) %>
            <% } %>
        </ul>
    </div>
    <div>
        <h2>Categories</h2>
        <form action="/category/create" method="get"><button type="submit">Add A category</button></form>
        <a href="/category">See All categories</a>
        <ul>
            <% if (locals.categories) { %>
                <% categories.forEach(category => { %>
                    <li><a href="/category/<%= category.id %>" ><%= category.category %></a></li>
                <% }) %>
            <% } %>
        </ul>
    </div>
</body>
</html>